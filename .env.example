# Copy to .env.local and fill in from Firebase console:
#   Project settings > General > Your apps > Web app > SDK setup and configuration > Config
# These web config values are identifiers, not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required: Firebase AI Logic enforces App Check from 2 Nov 2026).
# reCAPTCHA Enterprise site key, from Firebase console > App Check > Apps > your web app.
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only. Set to "true" to make the SDK print a debug token in the
# browser console, then register that token in Firebase console > App Check > Manage debug tokens.
# Never set this in a production build.
VITE_APPCHECK_DEBUG=false
# Alternative to the above: generate a debug token in Firebase console > App Check > Apps >
# Manage debug tokens > Add debug token > Generate, register it, and paste it here.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud Gemini model used for hybrid fallback.
# Defaults to the SDK's hybrid default (gemini-3.5-flash-lite in firebase@13).
VITE_GEMINI_CLOUD_MODEL=

# Optional: the cloud Gemini model for the multi-turn assistant (function calling).
# Defaults to the model above. A larger model (e.g. a "flash" rather than "flash-lite"
# variant) plans tool calls better, if your project has access to it.
VITE_GEMINI_ASSISTANT_MODEL=

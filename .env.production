# Loaded only by production builds (`npm run build`, `npm run deploy`), and it wins over
# .env.local. It blanks the App Check debug settings so a debug token you use for local
# development can never be baked into the public site: anyone holding that token could
# call Gemini as your app. Production uses reCAPTCHA Enterprise instead.
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
